{
  "name": "pdx-mod-hub",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "helper",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
